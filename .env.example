# Agent model (required for every run that calls a model)
OPENAI_API_KEY=

# Judge model. Optional: without it the judge falls back to the strongest OpenAI model,
# which means the judge and the agent share a vendor (see ROADMAP §8, judge self-preference).
ANTHROPIC_API_KEY=

# xmemory engine (T3.3). Runs are `skipped`, not failed, when it is missing.
XMEMORY_API_KEY=

# Cache model calls on disk, keyed by hash(model, messages, tools), for cheap re-runs
# while developing checks. Set to 1 to enable.
LLM_CACHE=0
