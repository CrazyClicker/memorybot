# Agent model (required for every run that calls a model)
OPENAI_API_KEY=

# Judge model. Optional: without it the judge falls back to openai:gpt-5.6-sol, which means the
# judge and the agent share a vendor (see ROADMAP §8, judge self-preference). `eval run`
# announces the fallback and records the model that actually judged in the run result.
ANTHROPIC_API_KEY=

# xmemory engine (T3.3). Runs are `skipped`, not failed, when it is missing.
XMEMORY_API_KEY=
# Optional API override and cluster selection. The cluster is auto-selected only when the account
# exposes exactly one. Extraction defaults to the lower-quota `fast` mode.
XMEMORY_API_URL=
XMEMORY_CLUSTER_ID=
XMEMORY_EXTRACTION_LOGIC=fast

# OSS Mem0 operational telemetry. The adapter defaults this to false; set true to opt in.
MEM0_TELEMETRY=false

# Cache model calls on disk, keyed by hash(provider, model, call params), for cheap re-runs
# while developing checks. Set to exactly 1 to enable. A cached run replays recorded usage
# and cost, so real measurements need a cold cache.
LLM_CACHE=
LLM_CACHE_DIR=.llm-cache

# Live GitHub loop (M2, ROADMAP §6). The repository and everything non-secret is in
# live/config.yaml. Provide ONE bot identity (ROADMAP D13):
# - a machine account added as a collaborator with Write access, authenticated with a
#   *classic* PAT (`repo` scope): fine-grained tokens cannot act on a repository the
#   account does not own;
GITHUB_TOKEN=
# - or a GitHub App owned by the repository owner and installed on the repository
#   (issues, pull requests, contents: read/write; metadata: read).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# `pnpm live reset --issues` deletes demo issues, which needs the owner's rights; it uses
# `gh auth token` and never the bot identity.
